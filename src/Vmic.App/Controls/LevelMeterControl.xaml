<UserControl x:Class="Vmic.App.Controls.LevelMeterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="8">
    <Grid>
        <Border Background="{DynamicResource App.MeterTrack}" CornerRadius="4" />
        <Rectangle x:Name="FillRect"
                   Fill="{DynamicResource App.Accent}"
                   HorizontalAlignment="Stretch"
                   RenderTransformOrigin="0,0.5">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="FillScale" ScaleX="0" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="4" />
    </Grid>
</UserControl>
